{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "src/pages/profile/_business/open-jobs.js", "src/pages/_business-profile/business-profile.js", "src/utils/profiles/profile.contractor.utils.js", "src/pages/profile/_business/create.js", "src/pages/profile/_business/index.js", "src/pages/job/create.tsx", "src/store/useFeed.js", "src/utils/getLocations/getAllCountriesAndStates.js", "src/pages/job/[id]/proposals/_proposalsList.tsx", "src/components/chat/_messages.jsx", "src/pages/contract/_contractClient/index.jsx", "src/pages/contract/_clientContracts/index.tsx", "src/api/contract/milestone-api.js", "src/components/notifications/notificationDropdown.jsx", "src/store/useNotification.js"],
  "exclude": ["node_modules"]
}
